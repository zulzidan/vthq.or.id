{
  "name": "Flyer Dakwah",
  "description": "Satu entri untuk satu poster pada carousel Flyer Dakwah di homepage. Buat atau duplikasikan entri, pilih gambar, atur urutan, lalu publish.",
  "displayField": "title",
  "fields": [
    {
      "id": "title",
      "name": "Judul flyer",
      "type": "Symbol",
      "localized": false,
      "required": true,
      "validations": [{ "size": { "min": 1, "max": 150 } }]
    },
    {
      "id": "image",
      "name": "Gambar flyer",
      "type": "Link",
      "linkType": "Asset",
      "localized": false,
      "required": true,
      "validations": [{ "linkMimetypeGroup": ["image"] }]
    },
    {
      "id": "description",
      "name": "Deskripsi gambar",
      "type": "Text",
      "localized": false,
      "required": false,
      "validations": [{ "size": { "max": 1000 } }]
    },
    {
      "id": "order",
      "name": "Urutan tampilan",
      "type": "Integer",
      "localized": false,
      "required": true,
      "validations": [{ "range": { "min": 1, "max": 9999 } }],
      "defaultValue": { "en-US": 10 }
    },
    {
      "id": "enabled",
      "name": "Tampilkan di website",
      "type": "Boolean",
      "localized": false,
      "required": true,
      "validations": [],
      "defaultValue": { "en-US": true }
    }
  ]
}
